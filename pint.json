{
    "preset": "laravel",
    "rules": {
        "blank_line_before_statement": {
            "statements": [
                "continue",
                "return",
                "throw",
                "try"
            ]
        },
        "ordered_imports": {
            "sort_algorithm": "alpha",
            "imports_order": [
                "class",
                "function",
                "const"
            ]
        },
        "php_unit_method_casing": {
            "case": "camel_case"
        }
    }
}
